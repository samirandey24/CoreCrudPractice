@using CoreCrudWithJwt.Dto
@model ProductDto

<div>
    @ViewBag.ErrorMessage
</div>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow border-0"
                 style="background-color: #f1f3f2;">

                <!-- Header -->
                <div class="card-header text-white text-center"
                     style="background-color: #14532d;">

                    <h3 class="mb-0">
                        Add Product
                    </h3>

                </div>

                <!-- Body -->
                <div class="card-body p-4">

                    <form asp-action="CreateProduct" method="post">

                        <!-- Product Name -->
                        <div class="mb-3">

                            <label for="productName"
                                   class="form-label fw-semibold"
                                   style="color: #374151;">
                                Product Name
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="productName"
                                   asp-for="ProductName"
                                   placeholder="Enter product name"
                                   required />

                            <div class="invalid-feedback">
                                Please enter a product name.
                            </div>

                        </div>

                        <!-- Description -->
                        <div class="mb-3">

                            <label for="description"
                                   class="form-label fw-semibold"
                                   style="color: #374151;">
                                Description
                            </label>

                            <textarea class="form-control"
                                      id="description"
                                      asp-for="Description"
                                      rows="4"
                                      placeholder="Enter product description"
                                      required></textarea>

                            <div class="invalid-feedback">
                                Please enter a product description.
                            </div>

                        </div>

                        <!-- Price -->
                        <div class="mb-4">

                            <label for="price"
                                   class="form-label fw-semibold"
                                   style="color: #374151;">
                                Price
                            </label>

                            <input type="number"
                                   class="form-control"
                                   id="price"
                                   asp-for="Price"
                                   placeholder="Enter product price"
                                   min="0"
                                   step="0.01"
                                   required />

                            <div class="invalid-feedback">
                                Please enter a valid price.
                            </div>

                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid">

                            <button type="submit"
                                    name="btnsubmit"
                                    class="btn text-white"
                                    style="background-color: #14532d;">
                                Add Product
                            </button>

                        </div>

                    </form>

                    <!-- Back to Dashboard -->
                    <div class="text-center mt-3">

                        <a href="/Product/Index"
                           class="text-decoration-none fw-semibold"
                           style="color: #14532d;">
                            Back to Products
                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>
</div>